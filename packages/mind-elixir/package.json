{
  "name": "rehype-mind-elixir",
  "version": "1.0.0-beta.1",
  "description": "A rehype plugin for embedding interactive Mind Elixir mind maps in Markdown.",
  "keywords": [
    "zikojs",
    "rehype",
    "unified",
    "markdown",
    "mindmap",
    "mind-map",
    "mind-elixir"
  ],
  "homepage": "https://github.com/zakarialaoui10/rehype-plugins#rehype-plugins",
  "bugs": {
    "url": "https://github.com/zakarialaoui10/rehype-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zakarialaoui10/rehype-plugins.git",
    "directory": "packages/mind-elixir"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./src/index.js",
      "types": "./src/index.d.ts"
    },
    "./client": {
      "import": "./src/client.js"
    },
    "./rehype": {
      "import": "./src/rehype.js"
    },
    "./style": {
      "import": "./src/style.css"
    }
  },
  "license": "MIT",
  "author": "Zakaria Elalaoui",
  "type": "module",
  "dependencies": {
    "@zikojs/mind-elixir": "^1.0.0-alpha.1",
    "mind-elixir": "6.0.0-next.4",
    "unist-util-visit": "catalog:",
    "yaml": "catalog:",
    "ziko": "catalog:",
    "hast-util-to-string":"catalog:"
  },
  "devDependencies": {
    "remark-rehype": "catalog:",
    "unified": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "test": "vitest"
  }
}